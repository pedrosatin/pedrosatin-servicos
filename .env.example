# Copie para .env e preencha.

# Endpoint do Worker de auditoria.
# Local:      http://localhost:8787
# Publicado:  https://pedrosatin-audit.<seu-subdominio>.workers.dev
#
# O Worker recusa requisições cuja origem não esteja em ALLOWED_ORIGINS
# (worker/wrangler.toml). Ao publicar o site em um endereço novo, acrescente-o
# lá antes de esperar que a análise funcione.
VITE_AUDIT_ENDPOINT=http://localhost:8787

# Chave da API PageSpeed Insights.
# Criar em: https://console.cloud.google.com/apis/credentials
# Ativar a API "PageSpeed Insights API" no projeto. Gratuita, 25 mil consultas/dia.
# Sem a chave, a cota anônima compartilhada do Google costuma responder 429.
#
# A chave vai para o pacote do navegador, por ser VITE_*. Isso é aceitável
# porque ela é restrita por referenciador no console do Google: só as origens
# cadastradas lá conseguem usá-la. Mantenha a lista em dia.
VITE_PSI_KEY=
