# Copie para .env e preencha.

# Endpoint do Worker de auditoria.
# Local:      http://localhost:8787
# Publicado:  https://pedrosatin-audit.<seu-subdominio>.workers.dev
#
# O Worker recusa requisições cuja origem não esteja em ALLOWED_ORIGINS
# (worker/wrangler.toml). Ao publicar o site em um endereço novo, acrescente-o
# lá antes de esperar que a análise funcione.
VITE_AUDIT_ENDPOINT=http://localhost:8787

# PSI_KEY pertence ao Worker e não ao pacote do navegador.
# Configure com: cd worker && npx wrangler secret put PSI_KEY
# Em desenvolvimento com Wrangler, use worker/.dev.vars com PSI_KEY=<valor>.
# O servidor Node usa a variável de ambiente PSI_KEY.
# Sem PSI_KEY, o proxy usa a cota anônima do PageSpeed.
